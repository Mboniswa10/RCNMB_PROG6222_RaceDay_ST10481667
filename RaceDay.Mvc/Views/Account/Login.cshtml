@model RaceDay.Mvc.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h2 class="fw-bold mb-1">RACEDAY</h2>
                    <p class="mb-0">Your race. Your journey.</p>
                </div>

                <div class="card-body p-4">
                    <h4 class="text-center mb-4">Welcome Back</h4>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your email" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                                Password
                            </label>

                            <input asp-for="Password"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your password" />

                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 fw-bold">
                            Login
                        </button>
                    </form>

                    <hr />

                    <p class="text-center mb-0">
                        Don't have an account?
                        <a asp-controller="Account"
                           asp-action="Register"
                           class="fw-bold text-decoration-none">
                            Register here
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

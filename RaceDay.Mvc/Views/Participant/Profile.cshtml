@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <h2 class="mb-3">My Participant Profile</h2>

    <p class="text-muted">
        View your RaceDay account information.
    </p>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Account Information</h5>

            <p>
                <strong>Email Address:</strong>
                @Context.Session.GetString("UserEmail")
            </p>

            <p>
                <strong>Account Role:</strong>
                Participant
            </p>

            <div class="alert alert-info">
                Additional profile information can be added when
                participant profile management is implemented.
            </div>
        </div>
    </div>

    <a asp-controller="Participant"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>
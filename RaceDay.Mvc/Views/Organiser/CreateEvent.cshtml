@model RaceDay.Mvc.Models.CreateEventViewModel

@{
    ViewData["Title"] = "Create New Event";
}

<div class="container mt-4">
    <h2 class="mb-3">Create a New Race Event</h2>

    <p class="text-muted">
        Enter the details below to create a new RaceDay event.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post" asp-controller="Organiser" asp-action="CreateEvent">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="EventName" class="form-label">Event Name</label>
                    <input asp-for="EventName" class="form-control" required />
                    <span asp-validation-for="EventName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="EventType" class="form-label">Event Type</label>
                    <input asp-for="EventType" class="form-control" required />
                    <span asp-validation-for="EventType" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label">Event Date</label>
                        <input asp-for="EventDate" type="date" class="form-control" required />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="StartTime" class="form-label">Start Time</label>
                        <input asp-for="StartTime" type="time" class="form-control" required />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Venue" class="form-label">Venue</label>
                    <input asp-for="Venue" class="form-control" required />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Province" class="form-label">Province</label>
                        <input asp-for="Province" class="form-control" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
                        <input asp-for="DistanceKm" type="number"
                               class="form-control" min="0.01" step="0.1" required />
                        <span asp-validation-for="DistanceKm" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxParticipants" class="form-label">Maximum Participants</label>
                        <input asp-for="MaxParticipants" type="number"
                               class="form-control" min="1" required />
                        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="EntryFee" class="form-label">Entry Fee (R)</label>
                    <input asp-for="EntryFee" type="number"
                           class="form-control" min="0" step="0.01" required />
                    <span asp-validation-for="EntryFee" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RouteInformation" class="form-label">Route Information</label>
                    <textarea asp-for="RouteInformation" class="form-control" rows="2"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="WeatherInformation" class="form-label">Weather Information</label>
                    <textarea asp-for="WeatherInformation" class="form-control" rows="2"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    Create Event
                </button>

                <a asp-controller="Organiser"
                   asp-action="Events"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>